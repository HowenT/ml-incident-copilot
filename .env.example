# Optional: enables "Polish wording with Claude" on the Updates view.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Where the SQLite database and model artifacts live (default: ./data)
# DATA_DIR=./data
# Any SQLAlchemy URL works; only SQLite is tested (Postgres needs `pip install psycopg[binary]`).
# DATABASE_URL=sqlite:///./data/copilot.db

# Frontend -> backend
# API_URL=http://localhost:8000
